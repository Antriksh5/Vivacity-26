# Cloudinary Configuration
# Get these values from: https://console.cloudinary.com/settings/api-keys

VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Note: VITE_ prefix exposes variables to the frontend (for cloud_name and api_key only)
# API_SECRET should NEVER have VITE_ prefix - keep it server-side only!
